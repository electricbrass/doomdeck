{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "$comment": "todo: gcc and clang ci presets, testing presets, appimage preset, maybe flatpak preset if it does presets",
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Clang + Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_ALL_WARNINGS": "ON",
        "ENABLE_WERROR": "OFF"
      }
    },
    {
      "name": "dev-gcc",
      "displayName": "GCC + Ninja",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-gcc/",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "ENABLE_ALL_WARNINGS": "ON",
        "ENABLE_WERROR": "OFF"
      }
    },
    {
      "name": "ci-gcc",
      "displayName": "GCC Build for CI",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "ENABLE_ALL_WARNINGS": "ON",
        "ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "ci-clang",
      "displayName": "Clang Build for CI",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_ALL_WARNINGS": "ON",
        "ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "test",
      "displayName": "Unit Tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_ALL_WARNINGS": "ON",
        "ENABLE_WERROR": "ON",
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "appimage",
      "displayName": "AppImage",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-appimage/",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FETCHCONTENT_TRY_FIND_PACKAGE_MODE": "NEVER",
        "ENABLE_ASAN": "OFF",
        "ENABLE_UBSAN": "OFF",
        "ENABLE_LTO": "ON",
        "BUILD_TESTING": "OFF",
        "STATIC_CXX_RUNTIME": "ON",
        "INSTALL_LEGACY_METADATA": "ON",
        "USE_INTERNAL_SQLITE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "targets": ["doomdeck"]
    },
    {
      "name": "ci-gcc",
      "configurePreset": "ci-gcc"
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang"
    },
    {
      "name": "test",
      "configurePreset": "test",
      "targets": ["unittest"]
    },
    {
      "name": "appimage",
      "configurePreset": "appimage",
      "targets": ["doomdeck"]
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "test",
      "steps": [
        {
          "type": "configure",
          "name": "test"
        },
        {
          "type": "build",
          "name": "test"
        },
        {
          "type": "test",
          "name": "test"
        }
      ]
    }
  ]
}
