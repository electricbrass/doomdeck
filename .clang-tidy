# yaml-language-server: $schema=https://www.schemastore.org/clang-tidy.json
---
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  modernize-*,
  bugprone-*,
  performance-*,
  -performance-enum-size,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-type-vararg,
  google-explicit-constructor,
  google-runtime-int,
  readability-*,
  -readability-identifier-length,
  -readability-qualified-auto,
  -readability-identifier-naming
CheckOptions:
  # currently identifier naming is disabled, havent decided on a style yet
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: snake_case
  - key: readability-identifier-naming.MethodCase
    value: camelBack
  # Allow `if (pointer)`
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true
  # Allow leaving off return types for lambdas
  - key: modernize-use-trailing-return-type.TransformLambdas
    value: none
